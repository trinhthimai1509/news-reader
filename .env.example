POSTGRES_PASSWORD=replace-with-a-long-random-password
POLL_INTERVAL=2m
FULL_TEXT_ENABLED=true
APP_PORT=8080
# Published on loopback only. Do not change to 0.0.0.0 without HTTPS in front.
APP_BIND=127.0.0.1
# Admin login (reading needs none). Create the account with:
#   docker compose exec app /app/server admin create <username>
# Set COOKIE_SECURE=true when the app is served over HTTPS.
COOKIE_SECURE=false
ADMIN_SESSION_TTL=12h
ADMIN_SESSION_IDLE=2h
# Address of the "Báo lỗi qua email" button (shown to the admin only).
# REPORT_EMAIL=
# RAM limits per container (measured for a 1 GB VPS, docs/DANH-GIA-VPS.md).
# On a 2 GB VPS: DB_MEM_LIMIT=768m and APP_MEM_LIMIT=384m.
# DB_MEM_LIMIT=384m
# APP_MEM_LIMIT=192m
