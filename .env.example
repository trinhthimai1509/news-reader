POSTGRES_PASSWORD=replace-with-a-long-random-password
ADMIN_TOKEN=replace-with-at-least-32-random-characters
POLL_INTERVAL=2m
FULL_TEXT_ENABLED=true
APP_PORT=8080
# true = no access code for requests from this machine only (requires APP_BIND
# on loopback). Never enable behind a reverse proxy or with APP_BIND=0.0.0.0.
LOCAL_NO_AUTH=false
APP_BIND=127.0.0.1
